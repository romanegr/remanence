{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remanence/schemas/item.schema.json",
  "title": "remanence catalogue item",
  "description": "Publication item (CONVENTIONS.md §5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "title",
    "kind",
    "platform",
    "copyright_status",
    "disks"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ia_identifier": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "ready", "published"] },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["single_title", "compilation"] },
    "date": { "type": ["integer", "string"] },
    "publisher": { "type": "string" },
    "platform": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "copyright_status": {
      "type": "string",
      "enum": [
        "public_domain",
        "freeware",
        "shareware",
        "licenseware",
        "cardware",
        "commercial",
        "unknown"
      ]
    },
    "publish_despite_copyright": { "type": "boolean" },
    "subjects": { "type": "array", "items": { "type": "string" } },
    "cross_refs": {
      "type": "object",
      "properties": {
        "tosec": { "type": "string" },
        "mobygames": { "type": "string" }
      }
    },
    "collection": { "type": "string" },
    "rights": { "type": "string" },
    "disks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^disk-[0-9]{2,}$" }
    },
    "notes": { "type": "string" }
  }
}
