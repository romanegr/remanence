{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remanence/schemas/contents.schema.json",
  "title": "remanence item contents",
  "description": "Title inventory of an item (CONVENTIONS.md §5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "titles"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "on_disks"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "date": { "type": ["integer", "string"] },
          "publisher": { "type": "string" },
          "on_disks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^disk-[0-9]{2,}$" }
          }
        }
      }
    }
  }
}
